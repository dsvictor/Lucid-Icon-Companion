{
  "id": "com.jayanta.lucide-companion",
  "name": "Lucide Companion",
  "version": "0.1.0",
  "description": "Search Lucide icons, insert editable vector layers and export SVG files.",
  "author": "Jayanta",
  "main": "lucide_companion.wasm",
  "api": 6,
  "permissions": {
    "access": "write",
    "saveFile": true,
    "commands": ["view.get", "node.create", "vector.create", "node.get", "node.set"]
  },
  "commands": [
    {
      "id": "browse",
      "label": "Lucide icon browser…"
    }
  ]
}
